APP_NAME=Bancolombia RAG
APP_ENV=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bancolombia_eval_bge_m3

EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu

RERANKER_PROVIDER=bge
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

BANK_START_URLS=https://www.bancolombia.com/,https://www.bancolombia.com/personas/tarjetas-de-credito,https://www.bancolombia.com/personas/productos/cuentas/tarjetas-debito
BANK_ALLOWED_DOMAIN=bancolombia.com
SCRAPER_MAX_PAGES=30
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_RATE_LIMIT_SECONDS=1.0
SCRAPER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Safari/537.36
SCRAPER_ACCEPT=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8
SCRAPER_ACCEPT_LANGUAGE=es-CO,es;q=0.9,en;q=0.8
SCRAPER_ACCEPT_ENCODING=gzip, deflate
SCRAPER_HTTP2=true
SCRAPER_DISALLOWED_PATTERNS=/*myportal*,/rest/*,/cgi/*,/crypto-js/*,/*formulario*,/*?ofertaId*,/*pdf*,/*!ut/p/z0/*,/*!ut/p/z1/*,/*buscador*,/wps/portal/preguntas-frecuentes/preguntas/*,/personas/solicitud-de-productos/*,*/preaprobados*,*/preaprobados-digitales*,*/oferta/*,/centro-de-ayuda/preguntas-frecuentes/resultados*
RAW_DATA_PATH=data/raw/bancolombia_documents.jsonl
PROCESSED_DATA_PATH=data/processed/bancolombia_documents.jsonl

CHUNK_SIZE=900
CHUNK_OVERLAP=150

RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATE_K=15
RERANK_ENABLED=false
RERANK_TOP_K=5
RERANK_TOP_N=4
RAG_CONTEXT_TOP_K=5
RAG_MIN_RETRIEVAL_SCORE=
MEMORY_MAX_MESSAGES=8
